{
  "name": "pneumata-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Sense Murmur client",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "node scripts/install-native-deps.mjs --desktop && electron electron/main.cjs --dev-server=http://localhost:5173",
    "install:native:desktop": "node scripts/install-native-deps.mjs --desktop",
    "install:native:android": "node scripts/install-native-deps.mjs --android",
    "build": "tsc -b && vite build",
    "build:bundle": "vite build",
    "build:cloud": "VITE_BACKEND_ORIGIN=http://sense.lyixi.com:5170 vite build",
    "build:desktop:web": "VITE_BACKEND_ORIGIN=http://sense.lyixi.com:5170 VITE_APP_BASE=./ VITE_APP_ROUTER=hash VITE_DISABLE_PWA=1 vite build",
    "build:desktop": "node scripts/install-native-deps.mjs --desktop && npm run build:desktop:web && electron-builder",
    "build:android:web": "VITE_BACKEND_ORIGIN=http://sense.lyixi.com:5170 VITE_APP_BASE=./ VITE_APP_ROUTER=hash VITE_DISABLE_PWA=1 vite build",
    "android:sync": "node scripts/install-native-deps.mjs --android && npm run build:android:web && cap sync android",
    "android:open": "node scripts/install-native-deps.mjs --android && cap open android",
    "package:all": "node scripts/package-all.mjs",
    "package:all:dry": "node scripts/package-all.mjs --dry-run",
    "typecheck": "tsc -p tsconfig.app.json --pretty false",
    "typecheck:watch": "tsc -p tsconfig.app.json --pretty false --watch --preserveWatchOutput",
    "typecheck:test": "tsc -p tsconfig.test.json --pretty false",
    "lint": "eslint .",
    "lint:changed": "node scripts/lint-changed.mjs",
    "check:dev": "node scripts/lint-changed.mjs",
    "test": "vitest run",
    "test:related": "vitest run --passWithNoTests --testTimeout=15000",
    "test:fast": "vitest run --testTimeout=10000 src/types/chat.test.ts src/types/settings.test.ts src/stores/storeMigrations.test.ts src/stores/storePersistenceScope.test.ts src/services/currentChatMessages.test.ts src/services/messageBranching.test.ts src/services/apiErrorMessage.test.ts",
    "test:sync": "vitest run --testTimeout=15000 src/stores/storePersistenceScope.test.ts src/stores/storeMigrations.test.ts src/stores/storeCloudNoopSync.test.ts src/stores/useChatStore.runtimePersistence.test.ts src/stores/useCharacterStore.runtimePersistence.test.ts src/stores/useMessageStore.runtimePersistence.test.ts src/stores/storeSyncScheduler.test.ts src/services/localOutboxProjection.test.ts src/services/localOutboxDb.test.ts src/services/syncConflictRecords.test.ts",
    "test:cloud-sync": "vitest run src/stores/cloudSyncCrossDevice.test.ts src/stores/useMessageStore.test.ts src/stores/useChatStore.runtimePersistence.test.ts src/stores/useMessageStore.runtimePersistence.test.ts src/stores/useAssistantArtifactStore.test.ts src/stores/storeSyncScheduler.test.ts src/services/api.test.ts src/services/localToCloudBootstrap.test.ts src/services/localOutboxProjection.test.ts src/services/localOutboxDb.test.ts src/services/syncConflictRecords.test.ts",
    "test:full": "node scripts/full-regression.mjs",
    "test:admin-browser-smoke": "node scripts/admin-browser-smoke.mjs",
    "test:auth-browser-smoke": "node scripts/auth-multitab-browser-smoke.mjs",
    "test:deliberation-browser-smoke": "node scripts/deliberation-browser-smoke.mjs",
    "test:message-branching-browser-smoke": "node scripts/message-branching-browser-smoke.mjs",
    "test:story-browser-smoke": "node scripts/story-room-browser-smoke.mjs",
    "test:assistant-html-browser-smoke": "node scripts/assistant-html-browser-smoke.mjs",
    "test:ai-llm-acceptance": "node scripts/ai-llm-acceptance.mjs",
    "test:ai-chatflow-acceptance": "node scripts/ai-llm-acceptance.mjs --cases=chatflow",
    "test:ai-inner-life-lab": "node scripts/ai-inner-life-lab.mjs",
    "test:ai-reasoning-ab": "node scripts/ai-reasoning-ab.mjs",
    "test:story-llm-acceptance": "node scripts/story-llm-acceptance.mjs",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.lyixi.sensemurmur",
    "productName": "生息 Sense Murmur",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "extraMetadata": {
      "dependencies": {}
    },
    "win": {
      "target": [
        "dir"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@capacitor/core": "^7.4.4",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tanstack/react-virtual": "^3.13.23",
    "fflate": "^0.8.3",
    "i18next": "^26.0.4",
    "mermaid": "^11.16.0",
    "openai": "^6.34.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "uuid": "^13.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/types": "^7.28.5",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  },
  "nativeDependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "electron": "37.4.0",
    "electron-builder": "^26.0.12"
  }
}
